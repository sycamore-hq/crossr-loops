#!/usr/bin/env python3
"""Verify graph skill, persona, and subgraph names resolve.

Every `uses.skill` and `requires.skills` name in graphs/*.json must resolve
to `.agents/skills/<name>/SKILL.md` in this checkout or the catalog.
Every `uses.persona` must resolve to `.agents/agents/<name>.md`.
Every `uses.graph` must resolve to `graphs/<name>.json`.

A graph with `requires.book: true` must not name a book skill. A book skill
is a catalog directory whose SKILL.md frontmatter has `metadata.book: "true"`
(the same marker extract-rules selects on). Membership is not inferred from
RULES.md or a `## Rules` heading.

A consumer lockfile may be supplied via `CROSSR_CONSUMER_LOCKFILE`. That is
never the loops self-pin. `requires.book: true` plus an explicit `books = []`
is a failure. Absence of the `books` key is not.

Persona `## Required Skills` lines are resolved the same way as graph
skills. Only backtick-quoted names count; prose such as "the disclosed
book" is ignored.

Catalog resolution (no silent substitutes):

- Local `.agents/skills/` in this checkout is always consulted.
- `CROSSR_SKILLS_PATH` is trusted as given when set.
- A sibling `crossr-skills` checkout is never used as the pin.
- This script does not clone. Missing catalog → fail, name the pin.

Failure text names the trees actually checked.

Rationale: loops#4 shipped dangling `rust-architect` graph references that
only a human grep caught. Mechanical before LLM.
"""

from __future__ import annotations

import json
import os
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
GRAPHS = ROOT / "graphs"
AGENTS = ROOT / ".agents" / "agents"
LOCAL_SKILLS = ROOT / ".agents" / "skills"
SCHEMA_NAME = "schema.json"
LOCKFILE = ROOT / "lockfile.toml"
FRONTMATTER_RE = re.compile(r"^---\n(.*?)\n---\n", re.S)
CONSUMER_LOCKFILE_ENV = "CROSSR_CONSUMER_LOCKFILE"
BOOKS_RE = re.compile(r"(?m)^\s*books\s*=\s*\[(.*?)\]")
REQUIRED_SKILLS_RE = re.compile(
    r"(?ms)^## Required Skills[^\n]*\n(.*?)(?=^## |\Z)"
)
SKILL_TICK_RE = re.compile(r"`([a-z][a-z0-9-]*)`")


class Check:
    def __init__(self) -> None:
        self.ok: list[str] = []
        self.bad: list[str] = []

    def pass_(self, msg: str) -> None:
        print(f"  ✓ {msg}")
        self.ok.append(msg)

    def fail(self, msg: str) -> None:
        print(f"  ✗ {msg}")
        self.bad.append(msg)


def load_graphs() -> dict[str, dict]:
    out = {}
    for path in sorted(GRAPHS.glob("*.json")):
        if path.name == SCHEMA_NAME:
            continue
        with path.open() as f:
            out[path.stem] = json.load(f)
    return out


def lockfile_skills_pin() -> str | None:
    if not LOCKFILE.is_file():
        return None
    m = re.search(r'(?m)^\s*skills\s*=\s*"([^"]+)"', LOCKFILE.read_text())
    return m.group(1) if m else None


def parse_frontmatter(text: str) -> dict[str, str]:
    match = FRONTMATTER_RE.match(text)
    if not match:
        return {}
    fields: dict[str, str] = {}
    for line in match.group(1).splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        fields[key.strip()] = value.strip()
    return fields


def is_book_frontmatter(fields: dict[str, str]) -> bool:
    raw = fields.get("book") or ""
    return raw.strip("\"'").lower() in {"true", "yes", "1"}


def extract_required_skills(text: str) -> list[str]:
    """Backtick-quoted skill names under ## Required Skills. Prose is ignored."""
    match = REQUIRED_SKILLS_RE.search(text)
    if not match:
        return []
    return SKILL_TICK_RE.findall(match.group(1))


def parse_lockfile_books(text: str) -> list[str] | None:
    """Return the books array when the key is present; None when absent."""
    match = BOOKS_RE.search(text)
    if not match:
        return None
    inner = match.group(1).strip()
    if not inner:
        return []
    return [part.strip().strip("\"'") for part in inner.split(",") if part.strip()]


def requires_book(g: dict) -> bool:
    return bool((g.get("requires") or {}).get("book"))


def verify_persona_skills(catalog: Path | None, c: Check) -> None:
    if not AGENTS.is_dir():
        return
    trees = trees_checked(catalog)
    for path in sorted(AGENTS.glob("*.md")):
        names = extract_required_skills(path.read_text())
        if not names:
            continue
        start = len(c.bad)
        for skill in names:
            if skill_path(skill, catalog) is None:
                c.fail(
                    f"persona {path.name}: skill {skill!r} has no "
                    f".agents/skills/{skill}/SKILL.md in {trees}"
                )
        if len(c.bad) == start:
            c.pass_(f"persona {path.stem}: {len(names)} required skill(s) resolve")


def verify_consumer_books(graphs: dict[str, dict], c: Check) -> None:
    raw = os.environ.get(CONSUMER_LOCKFILE_ENV)
    if not raw:
        return
    path = Path(raw)
    if not path.is_file():
        c.fail(f"{CONSUMER_LOCKFILE_ENV}={path} is not a file")
        return
    books = parse_lockfile_books(path.read_text())
    if books is None:
        c.pass_(f"consumer lockfile has no books key ({path})")
        return
    if books:
        c.pass_(f"consumer lockfile books = {books}")
        return
    named = [name for name, g in sorted(graphs.items()) if requires_book(g)]
    if not named:
        c.pass_("consumer lockfile books = [] and no graph requires.book")
        return
    c.fail(
        "requires.book: true + books = [] — disclose a language book "
        f"(graphs: {', '.join(named)})"
    )


def resolve_catalog(c: Check, pin: str | None) -> Path | None:
    raw = os.environ.get("CROSSR_SKILLS_PATH")
    if not raw:
        pin_bit = f" at lockfile pin {pin!r}" if pin else ""
        c.fail(
            "catalog required: set CROSSR_SKILLS_PATH to a checkout of "
            f"sycamore-hq/crossr-skills{pin_bit} "
            "(a sibling checkout is never used as the pin)"
        )
        return None
    path = Path(raw)
    if not path.joinpath(".agents", "skills").is_dir():
        c.fail(f"CROSSR_SKILLS_PATH={path} has no .agents/skills/")
        return None
    return path


def trees_checked(catalog: Path | None) -> str:
    parts = [f"this checkout ({ROOT})"]
    if catalog is not None:
        parts.append(f"CROSSR_SKILLS_PATH={catalog}")
    return " and ".join(parts)


def skill_path(name: str, catalog: Path | None) -> Path | None:
    local = LOCAL_SKILLS / name / "SKILL.md"
    if local.is_file():
        return local
    if catalog is not None:
        p = catalog / ".agents" / "skills" / name / "SKILL.md"
        if p.is_file():
            return p
    return None


def skill_is_book(name: str, catalog: Path | None) -> bool:
    path = skill_path(name, catalog)
    if path is None:
        return False
    return is_book_frontmatter(parse_frontmatter(path.read_text()))


def collect_names(g: dict) -> tuple[set[str], set[str], set[str]]:
    skills: set[str] = set((g.get("requires") or {}).get("skills") or [])
    personas: set[str] = set()
    subgraphs: set[str] = set()
    for node in g.get("nodes") or []:
        if not isinstance(node, dict):
            continue
        uses = node.get("uses") or {}
        if uses.get("skill"):
            skills.add(uses["skill"])
        if uses.get("persona"):
            personas.add(uses["persona"])
        if uses.get("graph"):
            subgraphs.add(uses["graph"])
    return skills, personas, subgraphs


def verify(name: str, g: dict, catalog: Path | None, c: Check) -> None:
    skills, personas, subgraphs = collect_names(g)
    start = len(c.bad)
    trees = trees_checked(catalog)
    for skill in sorted(skills):
        if skill_path(skill, catalog) is None:
            c.fail(
                f"{name}: skill {skill!r} has no .agents/skills/{skill}/SKILL.md "
                f"in {trees}"
            )
        elif requires_book(g) and skill_is_book(skill, catalog):
            c.fail(
                f"{name}: requires.book forbids book skill {skill!r} "
                "(metadata.book = true)"
            )
    for persona in sorted(personas):
        p = AGENTS / f"{persona}.md"
        if not p.is_file():
            c.fail(f"{name}: persona {persona!r} has no {p.relative_to(ROOT)}")
    for graph in sorted(subgraphs):
        p = GRAPHS / f"{graph}.json"
        if not p.is_file():
            c.fail(f"{name}: graph {graph!r} has no {p.relative_to(ROOT)}")
    if len(c.bad) == start:
        c.pass_(
            f"{name}: {len(skills)} skill(s), {len(personas)} persona(s), "
            f"{len(subgraphs)} graph(s) resolve"
        )


def main() -> int:
    c = Check()
    print("→ Verifying graph skill/persona/graph refs against named trees...")
    pin = lockfile_skills_pin()
    if pin:
        print(f"  pin: skills = {pin!r}")
    catalog = resolve_catalog(c, pin)
    if catalog is not None:
        print(f"  catalog: CROSSR_SKILLS_PATH={catalog}")
    else:
        print("  catalog: (none)")

    graphs = load_graphs()
    if not graphs:
        c.fail("no graph JSON files")
    if catalog is not None:
        for name in sorted(graphs):
            verify(name, graphs[name], catalog, c)
        verify_consumer_books(graphs, c)
        verify_persona_skills(catalog, c)

    print()
    if c.bad:
        print(f"✗ verify-skill-refs FAILED ({len(c.bad)} problem(s))")
        return 1
    print(f"✓ verify-skill-refs PASS ({len(graphs)} graphs, {len(c.ok)} check(s))")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
