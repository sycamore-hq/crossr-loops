{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sycamore-hq/crossr-loops/graphs/schema.json",
  "title": "crossr-loops Graph v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "nodes", "edges"],
  "properties": {
    "apiVersion": { "const": "crossr-loops/v0" },
    "kind": { "const": "Graph" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "conductor": {
      "type": "string",
      "description": "Local SKILL.md that remains the law for this graph."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "role": {
            "type": "string",
            "enum": ["generator", "adversary", "stage", "gate", "terminal", "graph"]
          },
          "catalog": {
            "type": "boolean",
            "description": "uses.skill is owned by crossr-skills."
          },
          "uses": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "skill": { "type": "string" },
              "persona": { "type": "string" },
              "graph": { "type": "string" }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "when": { "type": "string" }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
