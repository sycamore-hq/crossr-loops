{
  "apiVersion": "crossr-loops/v0",
  "kind": "Graph",
  "name": "code-gan",
  "start": "generate",
  "title": "Code GAN — inner implementation cycle",
  "description": "Generate → mechanical → tester → reviewer → commit. Architect only on an unsatisfiable claim. Catalog skills by name. SKILL.md is the law.",
  "conductor": "axel",
  "nodes": [
    {
      "id": "generate",
      "role": "generator",
      "catalog": true,
      "uses": {"skill": "code-writer"}
    },
    {"id": "mechanical", "role": "gate"},
    {
      "id": "tester",
      "role": "adversary",
      "catalog": true,
      "uses": {"skill": "testing", "persona": "tester-agent"}
    },
    {
      "id": "reviewer",
      "role": "adversary",
      "catalog": true,
      "uses": {"skill": "code-review", "persona": "reviewer-agent"}
    },
    {
      "id": "architect",
      "role": "adversary",
      "catalog": true,
      "uses": {"skill": "architecture", "persona": "architect-agent"}
    },
    {"id": "commit", "role": "gate"}
  ],
  "edges": [
    {"from": "generate", "to": "mechanical"},
    {"from": "mechanical", "to": "tester", "when": "pass"},
    {"from": "mechanical", "to": "generate", "when": "fail"},
    {"from": "tester", "to": "reviewer", "when": "BLESS"},
    {"from": "tester", "to": "generate", "when": "REJECT"},
    {"from": "reviewer", "to": "commit", "when": "BLESS"},
    {"from": "reviewer", "to": "generate", "when": "REJECT"},
    {"from": "generate", "to": "architect", "when": "unsatisfiable-claim"},
    {"from": "architect", "to": "mechanical", "when": "BLESS"},
    {"from": "architect", "to": "generate", "when": "REJECT"}
  ],
  "requires": {
    "skills": [
      "code-writer",
      "code-review",
      "testing",
      "architecture"
    ],
    "book": true
  }
}
